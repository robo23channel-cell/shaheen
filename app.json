{
  "expo": {
    "name": "الشاهين للشحن والتوصيل",
    "slug": "Shaheen-V2",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon-Sh.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#C1DEFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahmed.shaheen.v3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-Sh.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ahmed.shaheen.v3",
      "googleServicesFile": "./google-services.json",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/image.png"
    },
    "plugins": ["expo-secure-store"],
    "extra": {
      "eas": {
        "projectId": "9243efab-c614-471e-a714-27c39897e149"
      }
    },
    "owner": "mac23mak"
  }
}
